N0 <- 5
states <- expand.grid(
state = c("S", "H"),
k = 0:N0
)
View(states)
alpha <- 1
h_rate <- 10
n_states <- nrow(states)
Q <- matrix(0, n_states, n_states)
idx <- function(state, k) {
which(states$state == state & states$k == k)
}
for (k in 0:N0) {
# Searching -> Handling after eating prey
if (k > 0) {
from <- idx("S", k)
to <- idx("H", k - 1)
Q[from, to] <- alpha * k
}
# Handling -> Searching
from <- idx("H", k)
to <- idx("S", k)
Q[from, to] <- h_rate
}
diag(Q) <- -rowSums(Q)
View(Q)
N0
ctmc_mean_eaten <- function(N0, T_end, alpha, h_rate) {
obj <- build_Q(N0, alpha, h_rate)
Q <- obj$Q
states <- obj$states
# Initial condition: searching with N0 prey remaining
p0 <- rep(0, nrow(states))
p0[states$state == "S" & states$k == N0] <- 1
# Transient distribution at T_end
pT <- as.numeric(p0 %*% expm(Q * T_end))
prey_eaten <- N0 - states$k
sum(pT * prey_eaten)
}
View(Q)
ctmc_mean_eaten)(10, 1, 1, 10)
ctmc_mean_eaten(10, 1, 1, 10)
build_Q <- function(N0, alpha, h_rate) {
states <- expand.grid(
state = c("S", "H"),
k = 0:N0
)
n_states <- nrow(states)
Q <- matrix(0, n_states, n_states)
idx <- function(state, k) {
which(states$state == state & states$k == k)
}
for (k in 0:N0) {
# Searching -> Handling after eating prey
if (k > 0) {
from <- idx("S", k)
to <- idx("H", k - 1)
Q[from, to] <- alpha * k
}
# Handling -> Searching
from <- idx("H", k)
to <- idx("S", k)
Q[from, to] <- h_rate
}
diag(Q) <- -rowSums(Q)
list(Q = Q, states = states)
}
ctmc_mean_eaten(10, 1, 1, 10)
library(expm)
ctmc_mean_eaten(10, 1, 1, 10)
ctmc_mean_eaten(10, 1, 10, 10)
ctmc_mean_eaten(10, 1, 10, 100)
ctmc_mean_eaten(10, 1, 10, 100)
obj <- build_Q(N0, alpha, h_rate)
Q <- obj$Q
states <- obj$states
# Initial condition: searching with N0 prey remaining
p0 <- rep(0, nrow(states))
p0[states$state == "S" & states$k == N0] <- 1
# Transient distribution at T_end
pT <- as.numeric(p0 %*% expm(Q * T_end))
T_end <- 1
# Transient distribution at T_end
pT <- as.numeric(p0 %*% expm(Q * T_end))
prey_eaten <- N0 - states$k
xsum(pT * prey_eaten)
