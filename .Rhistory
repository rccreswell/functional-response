library(targets)
use_targets()
simulate_fish_ctmc <- function(
N0,
T_end,
alpha,
h_rate,
dt_out = 1,
seed = NULL
) {
if (!is.null(seed)) set.seed(seed)
# State variables
t <- 0
state <- "searching"
prey_remaining <- N0
prey_eaten <- 0
events <- data.frame(
time = t,
state = state,
prey_remaining = prey_remaining,
prey_eaten = prey_eaten
)
while (t < T_end && prey_remaining > 0) {
if (state == "searching") {
# Capture rate increases with prey remaining
rate <- alpha * prey_remaining
wait <- rexp(1, rate = rate)
t_next <- t + wait
if (t_next > T_end) break
# Capture occurs
t <- t_next
prey_remaining <- prey_remaining - 1
prey_eaten <- prey_eaten + 1
state <- "handling"
} else if (state == "handling") {
# Finish handling and return to searching
wait <- rexp(1, rate = h_rate)
t_next <- t + wait
if (t_next > T_end) break
t <- t_next
state <- "searching"
}
events <- rbind(
events,
data.frame(
time = t,
state = state,
prey_remaining = prey_remaining,
prey_eaten = prey_eaten
)
)
}
# Regular output time grid
out_times <- seq(0, T_end, by = dt_out)
prey_eaten_ts <- sapply(out_times, function(tt) {
idx <- max(which(events$time <= tt))
events$prey_eaten[idx]
})
state_ts <- sapply(out_times, function(tt) {
idx <- max(which(events$time <= tt))
events$state[idx]
})
time_series <- data.frame(
time = out_times,
prey_eaten = prey_eaten_ts,
state = state_ts
)
list(
events = events,
time_series = time_series
)
}
sim <- simulate_fish_ctmc(
N0 = 50,
T_end = 60,
alpha = 0.01,
h_rate = 2,
dt_out = 0.5,
seed = 1
)
head(sim$events)
head(sim$time_series)
plot(
sim$time_series$time,
sim$time_series$prey_eaten,
type = "s",
xlab = "Time",
ylab = "Number of prey eaten"
)
sim <- simulate_fish_ctmc(
N0 = 50,
T_end = 60,
alpha = 0.01,
h_rate = 2,
dt_out = 0.5,
seed = 1
)
head(sim$events)
head(sim$time_series)
plot(
sim$time_series$time,
sim$time_series$prey_eaten,
type = "s",
xlab = "Time",
ylab = "Number of prey eaten"
)
run_replicates <- function(
n_replicates,
N0,
T_end,
alpha,
h_rate,
dt_out = 1,
seed = NULL
) {
if (!is.null(seed)) {
set.seed(seed)
}
sims <- lapply(seq_len(n_replicates), function(i) {
sim_df <- simulate_fish_ctmc(
N0 = N0,
T_end = T_end,
alpha = alpha,
h_rate = h_rate,
dt_out = dt_out
)
sim_df$id <- i
sim_df
})
do.call(rbind, sims)
}
