@mastersthesis{davilaSameDifferentAbstract2019,
	address = {Ann Arbor},
	title = {Same/{Different} {Abstract} {Concept} {Learning} in {Archerfish} ({Toxotes} chatareus)},
	abstract = {Abstract concept learning involves learning to respond to the relationship between stimuli, completely separated from the perceptual properties of the stimuli. While this ability has been found in a variety of nonhuman animals, evidence in nonmammalian, aquatic species has been scarce. Archerfish are known for their unique ability to hunt aerial prey by spitting streams of water and knocking them out of the air. Recently, archerfish have been used in a range of behavioral studies. In a series of experiments, Newport, Wallis, and Siebeck (2015; see also Newport, Wallis, Temple \& Siebeck, 2013), found little abstract concept learning capability in archerfish, generally, and no evidence of same/different concept learning specifically. The current experiment served as a follow up, focusing on expanding the number of training stimuli used, which has been shown to be a factor in eliciting same/different discrimination in a variety of species (Wright \& Katz, 2006). As in the Newport et al. experiments, archerfish in this experiment were unable to acquire the same/different discrimination, further suggesting that archerfish are not able to learn abstract concepts.},
	language = {English},
	school = {Villanova University},
	author = {Dávila, Adam Anthony},
	year = {2019},
	note = {davilaSameDifferentAbstract2019
davilaSameDifferentAbstract2019},
	keywords = {0602:Behavioral Sciences, 0623:Experimental psychology, 0633:Cognitive psychology, 0989:Physiological psychology, Archerfish, Behavioral sciences, Cognitive psychology, Concept Learning, Experimental psychology, Physiological psychology},
}

@article{daviesSuspectedViralErythrocytic2009,
	title = {Suspected viral erythrocytic necrosis ({VEN}) in a juvenile blackbar triggerfish, {Rhinecanthus} aculeatus, from {Lizard} {Island}, {Great} {Barrier} {Reef}, {Australia}},
	volume = {2},
	doi = {10.1017/s1755267209990674},
	abstract = {Suspected viral erythrocytic necrosis (VEN) was detected in blood films from an immature blackbar triggerfish, Rhinecanthus aculeatus, captured on a patch reef at Lizard Island, Great Barrier Reef in November 2005, probably the first record of such an infection from Australia. The fish was kept in captivity and sampled intermittently until December 2007. Giemsa-stained blood films showed initially {\textasciitilde}18\% of mature erythrocytes affected by the VEN-like condition, but accompanying erythroblasts appeared free from infection. Erythrocytes with VEN-like bodies were smooth or crenated in outline, while the inclusion bodies were intracytoplasmic, single or paired, round in outline, stained deep magenta and were between 0.5–1.7 μm across. Bodies associated with clouds of granular material, fine eosinophilic haloes, and distinct pink-stained comet-tails, were also observed. The DNA content of the VEN-like bodies was confirmed by their green fluorescence following acridine orange staining. Infection levels in this fish fell to 0.4\% of mature erythrocytes by May 2006 and persisted at this level until December 2007, when the fish died after just over two years in captivity. Squashes of haematophagous, juvenile gnathiid isopods taken from this fish on initial capture, also contained eosinophilic VEN-like bodies within digesting erythrocytes, suggesting that these crustaceans may be vectors of the condition observed.},
	journal = {Marine Biodiversity Records},
	author = {Davies, Angela J. and Curtis, Lynda and Grutter, Alexandra S. and Smit, Nico J.},
	year = {2009},
	note = {daviesSuspectedViralErythrocytic2009
daviesSuspectedViralErythrocytic2009},
	keywords = {Great Barrier Reef, Rhinecanthus aculeatus, blackbar triggerfish, suspected viral erythrocytic necrosis (VEN)},
	pages = {e149},
}

