zentallAssociativeConceptLearning2014},
	keywords = {Animals, Association Learning, Behavior, Cognition, Communication, Concept Formation, Cultural Evolution, Discrimination Learning, Generalization, Stimulus, Humans, Learning, Pattern Recognition, Visual, Psychology, Reinforcement (Psychology), Species Specificity, Symmetry},
