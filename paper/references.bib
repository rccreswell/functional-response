@article{bodilyMatchingtosampleAbstractconceptLearning2008,
	title = {Matching-to-sample abstract-concept learning by pigeons},
	volume = {34},
	issn = {1939-2184(Electronic);0097-7403(Print)},
	doi = {10.1037/0097-7403.34.1.178},
	abstract = {Abstract concepts--rules that transcend training stimuli--have been argued to be unique to some species. Pigeons, a focus of much concept-learning research, were tested for learning a matching-to-sample abstract concept. Five pigeons were trained with three cartoon stimuli. Pigeons pecked a sample 10 times and then chose which of two simultaneously presented comparison stimuli matched the sample. After acquisition, abstract-concept learning was tested by presenting novel cartoons on 12 out of 96 trials for 4 consecutive sessions. A cycle of doubling the training set followed by retraining and novel-testing was repeated eight times, increasing the set size from 3 to 768 items. Transfer performance improved from chance (i.e., no abstract-concept learning) to a level equivalent to baseline performance ({\textgreater}80\%) and was similar to an equivalent function for same/different abstract-concept learning. Analyses assessed the possibility that item-specific choice strategies accounted for acquisition and transfer performance. These analyses converged to rule out item-specific strategies at all but the smallest set-sizes (3-24 items). Ruling out these possibilities adds to the evidence that pigeons learned the relational abstract concept of matching-to-sample. (PsycINFO Database Record (c) 2014 APA, all rights reserved)},
	number = {1},
	journal = {Journal of Experimental Psychology: Animal Behavior Processes},
	author = {Bodily, Kent D. and Katz, Jeffrey S. and Wright, Anthony A.},
	year = {2008},
	note = {bodilyMatchingtosampleAbstractconceptLearning2008
bodilyMatchingtosampleAbstractconceptLearning2008},
	keywords = {*Abstraction, *Animal Learning, *Concept Formation, *Matching to Sample, *Transfer (Learning), Pigeons},
	pages = {178--184},
}

@article{bloughOdditemSearchPigeons1989,
	title = {Odd-item search in pigeons: {Display} size and transfer effects},
	volume = {15},
	issn = {1939-2184(Electronic);0097-7403(Print)},
	doi = {10.1037/0097-7403.15.1.14},
	abstract = {Pigeons searched arrays of small forms displayed on computer monitors. On each trial, a single target form appeared together with two or more identical distractor forms. A set of six different forms was used in each of three experiments. All possible combinations of these forms, paired as target and distractor, appeared in each experimental session. Both the accuracy and speed of search increased with the number of distractors displayed. When both targets and distractors were new, accuracy was above chance only for the large (24-item) display, where transfer was highly significant. The experiments do not support the attribution to pigeons of a general "oddity concept." Rather, the results suggest that odd-item performance depends in part on a perceptual isolation of the target and in part on familiarity with target-distractor combinations. (PsycINFO Database Record (c) 2012 APA, all rights reserved)},
	number = {1},
