	author = {Kilburn, Kaye H.},
	year = {2000},
	note = {Project 10
Project 10},
	keywords = {CENTRAL nervous system -- Diseases -- Risk factors, DIESEL motor exhaust gas, HEALTH, NEUROBEHAVIORAL disorders, RESPIRATORY organs -- Diseases -- Risk factors},
