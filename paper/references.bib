@article{mongilloRecognitionHumanFaces2017,
	title = {Recognition of human faces by dogs ({Canis} familiaris) requires visibility of head contour},
	issn = {1435-9456},
	doi = {10.1007/s10071-017-1108-4},
	abstract = {Researchers have suggested that dogs are able to recognise human faces, but conclusive evidence has yet to be found. Experiment 1 of this study investigated whether dogs can recognise humans using visual information from the face/head region, and whether this also occurs in conditions of suboptimal visibility of the face. Dogs were presented with their owner’s and a stranger’s heads, protruding through openings of an apparatus in opposite parts of the experimental setting. Presentations occurred in conditions of either optimal or suboptimal visibility; the latter featured non-frontal orientation, uneven illumination and invisibility of outer contours of the heads. Instances where dogs approached their owners with a higher frequency than predicted by chance were considered evidence of recognition. This occurred only in the optimal condition. With a similar paradigm, Experiment 2 investigated which of the alterations in visibility that characterised the suboptimal condition accounted for dogs’ inability to recognise owners. Dogs approached their owners more frequently than predicted by chance if outer head contours were visible, but not if heads were either frontally oriented or evenly illuminated. Moreover, male dogs were slightly better at recognition than females. These findings represent the first clear demonstration that dogs can recognise human faces and that outer face elements are crucial for such a task, complementing previous research on human face processing in dogs. Parallels with face recognition abilities observed in other animal species, as well as with human infants, point to the relevance of these results from a comparative standpoint.},
	journal = {Animal Cognition},
	author = {Mongillo, Paolo and Scandurra, Anna and Kramer, Robin S. S. and Marinelli, Lieta},
	month = jun,
	year = {2017},
	note = {mongilloRecognitionHumanFaces2017
mongilloRecognitionHumanFaces2017},
}

@article{mondalAmmoniaToxicityTolerance2025,
	title = {Ammonia toxicity tolerance and behavioural response in {Zebrafish}},
	volume = {2},
	issn = {3004-8893},
	doi = {10.1007/s44339-025-00028-8},
	abstract = {The investigation was done to determine toxicity tolerance level of ammonia in zebrafish (Danio rerio) as the fresh water fish model and find out the indicative changes in behavioural patterns to identify ammoniacal toxicant induced stress. For this, adult age-matched zebrafish were exposed to 0.1 mg/L to 5 mg/L conc. of NH3 consecutively for 96 h. When measured under bioavailable NH3 fixed for the experimental groups, LC50 value was 0.89 mg NH3/l under repetitive exposure which was confirmed by Kaplan–Meier curve showing cumulative survival {\textgreater} 0.6 at 72 h but {\textless} 0.4 at 96 h for 1 mg/L NH3 repetitive exposure. Quantitative behavioural analysis showed increasing NH3 conc. and consecutive exposure decreased playing behaviour from {\textasciitilde} 60\% to 30\% for sub-acute toxicity and to 5\% and less for acute toxicity of NH3, whereas increased stress movement from 15–20\% to 25–35\% for sub-acute and {\textgreater} 90\% for acute toxicity. Other significant shifts of behaviour identified that playing, feeding, aggression and stress movements are the key indicative behaviours under ammoniacal stress. Continued contamination of unionized ammonia was found less tolerant to fish and acute to sub-acute levels were reflected though shift of specific behavioural attributes.},
	number = {1},
	journal = {Discover Toxicology},
	author = {Mondal, Nabajit and Kaur, Jaspreet and Ghosh, Anirban},
	month = jun,
