@article{hunteBayesianMatingDecisions1985,
	title = {Bayesian mating decisions in an amphipod, {Gammarus} lawrencianus {Bousfield}},
	volume = {33},
	issn = {0003-3472},
	doi = {10.1016/s0003-3472(85)80060-9},
